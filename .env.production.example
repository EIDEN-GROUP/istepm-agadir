# ═══════════════════════════════════════════════════════════════
# school-CRM — Production Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env.production and fill in all values.
#
#   cp .env.production.example .env.production
#   nano .env.production
#   ./deploy.sh
#
# Architecture:
#   eiden-nginx (reverse proxy, TLS) → https://DOMAIN/
#   https://DOMAIN/        → nginx → React SPA
#   https://DOMAIN/api/*   → proxy → Backend API (Fastify)
#   https://DOMAIN/health  → proxy → Backend health check
#
# Generate secure random values with:
#   openssl rand -hex 32      (JWT_SECRET)
#   openssl rand -hex 16      (DB_PASSWORD, REDIS_PASSWORD)
#   openssl rand -base64 32   (ADMIN_API_KEY)
# ═══════════════════════════════════════════════════════════════

# ─── Required — MUST set these ─────────────────────────────────

# Main domain (both frontend and API are served here)
DOMAIN=

# Database
DB_PASSWORD=                               # Strong random password for PostgreSQL

# Redis
REDIS_PASSWORD=                            # Strong random password for Redis

# MinIO (S3-compatible object storage for exam documents)
MINIO_ACCESS_KEY=minioadmin                # MinIO access key
MINIO_SECRET_KEY=                          # Strong random secret key for MinIO

# JWT Authentication
JWT_SECRET=                                # Long random string (min 32 chars)
JWT_EXPIRES_IN=24h                         # Token lifetime (24h recommended)

# Admin API key (for SuperAdmin CRM multi-product integration)
ADMIN_API_KEY=                             # Random API key

# Feature tickets feed, pulled by the BMS (Website Contacts style source).
# Generate: openssl rand -hex 32. Share ONLY with the BMS team (server .env).
# Empty = the /api/feature-tickets/feed endpoint answers 503.
FEATURE_TICKETS_API_KEY=

# Grafana monitoring dashboard password
GRAFANA_PASSWORD=                          # Grafana admin password (defaults to "admin" if not set!)

# Let's Encrypt certificate notifications
ACME_EMAIL=

# ─── Landing maintenance mode ────────────────────────────────
# LANDING_LOCK=on shows a branded "Nous revenons très vite !" page
# (HTTP 503 + Retry-After) on the public landing page (/) ONLY.
# CRM (/login, /dashboard…), hashed assets and the API keep working.
# Default off. Changing it does NOT update running containers — it
# recreates the frontend tasks (no rebuild needed):
#   fast switch:  docker service update --env-add LANDING_LOCK=on school-crm_frontend
#   restore:      docker service update --env-add LANDING_LOCK=off school-crm_frontend
# Permanent: set the value here AND in the ENV_PRODUCTION GitHub secret
# (CI rewrites .env.production from that secret on every deploy),
# then redeploy (./deploy.sh or push to main).
LANDING_LOCK=off

# ─── Optional — set if you use these features ──────────────────

# Public frontend URL for invitation links (defaults to CORS origin / DOMAIN)
# FRONTEND_URL=https://istepm-agadir.eiden-group.com

# SMTP / Email sending
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@${DOMAIN}
ADMIN_EMAIL=admin@${DOMAIN}

# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# n8n Automation Webhook
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# AI Agent (NVIDIA NIM integration)
# Get a free API key at: https://build.nvidia.com/explore/retrieval
AI_API_KEY=
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=meta/llama-3.1-8b-instruct

# Logging
LOG_LEVEL=info
