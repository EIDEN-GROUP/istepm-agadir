# Production environment variables for school-CRM
# Copy to .env.production and fill in your values

# Domains
API_DOMAIN=api.school-crm.com
FRONTEND_DOMAIN=school-crm.com

# SSL
ACME_EMAIL=admin@school-crm.com

# Database
DB_PASSWORD=change-me-secure-password

# Redis
REDIS_PASSWORD=change-me-redis-password

# JWT
JWT_SECRET=change-me-jwt-secret-min-32-chars-long

# MinIO S3
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio-secret

# SMTP (optional – leave blank to disable email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@school-crm.com
ADMIN_EMAIL=admin@school-crm.com

# WhatsApp Cloud API (optional – leave blank to disable)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# n8n integration (optional)
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
