# ═══════════════════════════════════════════════════════════════
# school-CRM — Production Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env.production and fill in all values.
#
#   cp .env.production.example .env.production
#   nano .env.production
#   ./deploy.sh
#
# Generate secure random values with:
#   openssl rand -hex 32      (JWT_SECRET)
#   openssl rand -hex 16      (DB_PASSWORD, REDIS_PASSWORD)
#   openssl rand -base64 32   (ADMIN_API_KEY)
# ═══════════════════════════════════════════════════════════════

# ─── Required — MUST set these ─────────────────────────────────

# Domain names
FRONTEND_DOMAIN=crm.votredomaine.com       # Frontend SPA domain (CORS)
API_DOMAIN=api.votredomaine.com            # Backend API domain (Traefik routing)
ACME_EMAIL=admin@votredomaine.com          # Let's Encrypt certificate notifications

# Database
DB_PASSWORD=                               # Strong random password for PostgreSQL

# Redis
REDIS_PASSWORD=                            # Strong random password for Redis

# MinIO (S3-compatible object storage for exam documents)
MINIO_ACCESS_KEY=minioadmin                # MinIO access key (change for production)
MINIO_SECRET_KEY=                          # Strong random secret key for MinIO

# JWT Authentication
JWT_SECRET=                                # Long random string (min 32 chars)
JWT_EXPIRES_IN=24h                         # Token lifetime (7d default, 24h recommended)

# CORS — the frontend domain that may call the API
# WARNING: .env files do NOT expand ${VARIABLE} references.
# You MUST write the literal URL here.
CORS_ORIGIN=https://crm.votredomaine.com

# Admin API key (for SuperAdmin CRM multi-product integration)
ADMIN_API_KEY=                             # Random API key

# ─── Optional — set if you use these features ──────────────────

# SMTP / Email sending
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@votredomaine.com
ADMIN_EMAIL=admin@votredomaine.com

# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# n8n Automation Webhook
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# AI Agent (NVIDIA NIM integration)
# Get a free API key at: https://build.nvidia.com/explore/retrieval
AI_API_KEY=
AI_BASE_URL=https://integrate.api.nvidia.com/v1
# Find available models at: https://build.nvidia.com
AI_MODEL=meta/llama-3.1-8b-instruct

# Logging
LOG_LEVEL=info
