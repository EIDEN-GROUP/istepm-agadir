#!/bin/sh
# Garde-fous sourcés (pas exécutés) par /docker-entrypoint.sh AVANT envsubst.
# Toute valeur absente ou vide retombe sur un comportement sûr :
#   - LANDING_LOCK=off          → landing normale
#   - PROJECT_LOCK_ENABLED=false → aucun verrou global
# Seules les valeurs explicites "on" / "true" activent les verrous.
: "${LANDING_LOCK:=off}"
: "${PROJECT_LOCK_ENABLED:=false}"
export LANDING_LOCK
export PROJECT_LOCK_ENABLED
